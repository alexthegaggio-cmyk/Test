{
  "name": "skyward",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-capable planetarium and observing planner in a single HTML file.",
  "type": "module",
  "scripts": {
    "data": "node tools/prepare-data.mjs",
    "build": "node tools/build.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "e2e": "playwright test -c tests/e2e/playwright.config.mjs",
    "check": "npm run build && npm test && npm run e2e"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "astronomy-engine": "2.1.19",
    "city-timezones": "^1.3.1"
  }
}
